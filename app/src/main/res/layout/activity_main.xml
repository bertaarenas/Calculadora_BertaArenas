<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textViewTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="130dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="130dp"
        android:text="Calculadora de IMC"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/ETPeso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Introduce tu peso en kg"
        android:inputType="numberDecimal"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="199dp" />

    <EditText
        android:id="@+id/ETAltura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Introduce tu altura en cm"
        android:inputType="numberDecimal"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="302dp" />

    <RadioGroup
        android:id="@+id/rgUnidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

    </RadioGroup>

    <RadioButton
        android:id="@+id/btnMetros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Metros (m)"
        tools:layout_editor_absoluteX="55dp"
        tools:layout_editor_absoluteY="377dp" />

    <RadioButton
        android:id="@+id/btnCentimetros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Centímetros (cm)"
        tools:layout_editor_absoluteX="209dp"
        tools:layout_editor_absoluteY="377dp" />

    <Button
        android:id="@+id/button"
        android:layout_width="300dp"
        android:layout_height="82dp"
        android:backgroundTint="#E91E63"
        android:text="CALCULAR"
        tools:layout_editor_absoluteX="55dp"
        tools:layout_editor_absoluteY="465dp" />

    <TextView
        android:id="@+id/textViewResultado"
        android:layout_width="180dp"
        android:layout_height="71dp"
        android:text="Resultado"
        android:textSize="40sp"
        tools:layout_editor_absoluteX="115dp"
        tools:layout_editor_absoluteY="597dp" />

</androidx.constraintlayout.widget.ConstraintLayout>